# ============================================================
# IOOI 情绪蛋 · 环境变量模板
#
# 用法：
#   容器编排启动：  cp .env.example .env
#   本地运行后端：  cp .env.example emotion_database/.env
#
# 注意：真实的 .env 含有密钥，已被 .gitignore 排除，切勿提交到仓库。
# ============================================================

# ---------------- PostgreSQL ----------------
# 容器启动时 DB_HOST 会被 docker-compose 覆盖为 db，无需手动修改
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=emotion_app
DB_SSLMODE=disable

# ---------------- HTTP 服务 ----------------
SERVER_PORT=8080
# 可信代理列表，逗号分隔。仅当服务部署在反向代理之后才需要配置真实网关地址，
# 否则客户端可伪造 X-Forwarded-For，污染日志与限流判断。
TRUSTED_PROXIES=127.0.0.1

# ---------------- JWT ----------------
# 必填。留空或保留下方占位值，服务会拒绝启动。
# 生成命令（Git Bash / WSL / Linux / macOS）：
#   openssl rand -base64 32
JWT_SECRET=change_me_to_a_random_32_byte_secret
JWT_EXPIRE_HOURS=72
